# ==============================================================================
# Production-Grade Indian IPO Intelligence & Allotment Monitoring Platform
# ==============================================================================

# Application & Environment
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
APP_NAME=IPO-Intelligence-Platform
LOG_LEVEL=info

# PostgreSQL Database (PostgreSQL 16+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ipo_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# Redis (Redis 7+)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# Security & Cryptography (Generate 64 hex chars = 32 bytes)
# Example generation: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
PAN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PAN_HMAC_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
API_KEY_SECRET=changeme_api_secret_key_for_rest_endpoints

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
ADMIN_TELEGRAM_IDS=123456789,987654321

# Pushover API Integration
PUSHOVER_APP_TOKEN=
PUSHOVER_USER_KEY=

# IPO Data Providers & API Credentials
UPSTOX_CLIENT_ID=
UPSTOX_CLIENT_SECRET=
IPO_GURU_API_KEY=
IPO_NOTIFY_API_KEY=

# Allotment Polling & Concurrency Policies
ALLOTMENT_POLL_INTERVAL_MINUTES=5
ALLOTMENT_MAX_ATTEMPTS=100
ALLOTMENT_MAX_AGE_HOURS=72
BULK_WORKER_CONCURRENCY=5

# Rate Limits (Requests Per Minute per Provider)
LIMITER_NSE_RPM=30
LIMITER_BSE_RPM=30
LIMITER_MUFG_RPM=20
LIMITER_KFINTECH_RPM=20
LIMITER_BIGSHARE_RPM=20
LIMITER_UPSTOX_RPM=60

# Data Retention Policy (Days)
RAW_PROVIDER_DATA_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=365
RESULT_RETENTION_DAYS=3650
